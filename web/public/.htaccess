# Apache/LiteSpeed config for the static export on Hostinger.
# Firebase Hosting ignores this file; it reads firebase.json instead.

DirectoryIndex index.html

# Every route is exported as <route>/index.html (next.config.ts sets
# trailingSlash). MultiViews would guess at extensionless names and serve the
# wrong file, so it stays off. Indexes stays off so a folder without an index
# file is never listed.
Options -Indexes -MultiViews

# DirectorySlash is on by default and sends /tools to /tools/. Spelled out here
# so an old bookmark without the slash keeps working.
DirectorySlash On

ErrorDocument 404 /404.html

# --- Compression ---------------------------------------------------------
# Harmless on LiteSpeed, which normally compresses at server level; mod_brotli /
# mod_deflate are honoured where present. Uncompressed, the home page is ~1 MB
# instead of ~420 KB and mobile Lighthouse drops by ~20 points.
# AddOutputFilterByType needs mod_filter: wrapped so a missing module can never 500 the site.
<IfModule mod_brotli.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml application/xml application/manifest+json
  </IfModule>
</IfModule>
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml application/xml application/manifest+json
  </IfModule>
</IfModule>
<IfModule mod_headers.c>
  Header append Vary Accept-Encoding
</IfModule>

# --- Caching -------------------------------------------------------------
# Only /_next/static/ is content-hashed: cache it forever.
<IfModule mod_headers.c>
  # SetEnvIf needs mod_setenvif: wrapped so a missing module can never 500 the site.
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/_next/static/" PS_IMMUTABLE
    Header set Cache-Control "public, max-age=31536000, immutable" env=PS_IMMUTABLE
  </IfModule>
  # Documents and data must revalidate so a deploy shows up at once.
  <FilesMatch "\.(html|json|txt|vcf|xml|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# Un-hashed images, icons and fonts outside /_next/static: 7 days.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 7 days"
</IfModule>

# --- Never serve deploy-tool state files ---------------------------------
# The deploy no longer writes them (and retires old ones), but the rule stays as
# a guard. No Order/Deny fallback: that Apache 2.2 syntax answered HTTP 500 on
# LiteSpeed.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "^\.ftp-deploy-sync-state" - [F,L]
</IfModule>
<FilesMatch "^\.ftp-deploy-sync-state.*\.json$">
  Require all denied
</FilesMatch>
